{
  "name": "educonnect",
  "private": true,
  "version": "4.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort --host",
    "build": "tsc -b && oxlint ./src --deny-warnings && vite build --mode production",
    "lint": "oxlint ./src --deny-warnings --fix",
    "lint:check": "oxlint ./src --deny-warnings",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --strictPort --host",
    "server": "cross-env NODE_ENV=production json-server db.json --port 4003 --static ./public",
    "check": "npm run typecheck && npm run lint:check",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "json-server": "^1.0.0-beta.15",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
