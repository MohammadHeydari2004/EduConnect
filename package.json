{
  "name": "educonnect",
  "private": true,
  "version": "3.8.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && oxlint ./src && vite build",
    "lint": "oxlint ./src --fix",
    "lint:check": "oxlint ./src",
    "preview": "vite preview",
    "server": "cross-env JSON_SERVER_PORT=4003 json-server --watch db.json --port 4003",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-hook-form": "^7.88.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "json-server": "^1.0.0-beta.15",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#/*": "./src/*"
  }
}
