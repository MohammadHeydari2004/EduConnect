 6171: 62:     newErrors.title = "عنوان باید حداقل ۳ کاراکتر باشد.";
 6172: 63:   } else if (title.length > 100) {
 6173: 64:     newErrors.title = "عنوان نباید بیشتر از ۱۰۰ کاراکتر باشد.";
 6174: 65:   }
 6175: 66: 
 6176: 67:   if (!values.date) {
