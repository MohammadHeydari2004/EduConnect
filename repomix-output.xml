 7759: 155:           error={errors.email?.message}
 7760: 156:         />
 7761: 157: 
 7762: 158:         {mode === "create" && (
 7763: 159:           <Input
 7764: 160:             label="رمز عبور"
 7765: 161:             type="password"
 7766: 162:             autoComplete="new-password"
 7767: 163:             required
 7768: 164:             {...register("password", { validate: validatePassword })}
 7769: 165:             error={errors.password?.message}
 7770: 166:           />
 7771: 167:         )}
 7772: 168: 
 7773: 169:         <Select
 7774: 170:           label="نقش"
 7775: 171:           required
 7776: 172:           {...register("role", { validate: validateRole })}
 7777: 173:           options={[
 7778: 174:             { label: "مدیر", value: "admin" },
 7779: 175:             { label: "استاد", value: "teacher" },
 7780: 176:             { label: "دانشجو", value: "student" },
 7781: 177:           ]}
 7782: 178:           error={errors.role?.message}
 7783: 179:         />
 7784: 180: 
 7785: 181:         <Select
 7786: 182:           label="وضعیت"
 7787: 183:           required
 7788: 184:           {...register("status", { validate: validateStatus })}
 7789: 185:           options={[
 7790: 186:             { label: "فعال", value: "active" },
 7791: 187:             { label: "غیرفعال", value: "inactive" },
 7792: 188:           ]}
 7793: 189:           error={errors.status?.message}
 7794: 190:         />
 7795: 191: 
 7796: 192:         <div className="flex justify-end gap-2 pt-2">
 7797: 193:           <Button type="button" variant="secondary" onClick={onClose}>
