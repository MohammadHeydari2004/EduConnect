39: export const formatRelativeTime = (
40:   date: string | Date | null | undefined,
41: ): string => {
42:   if (!date) return "—";
43:   try {
44:     const dateObj = typeof date === "string" ? new Date(date) : date;
45:     if (isNaN(dateObj.getTime())) return "—";
46: 
47:     const now = new Date();
48:     const diffMs = now.getTime() - dateObj.getTime();
49:     const diffMinutes = Math.floor(diffMs / 60000);
50:     const diffHours = Math.floor(diffMinutes / 60);
51:     const diffDays = Math.floor(diffHours / 24);
52: 
53:     if (diffMinutes < 1) return "لحظاتی پیش";
54:     if (diffMinutes < 60) return `${diffMinutes} دقیقه پیش`;
55:     if (diffHours < 24) return `${diffHours} ساعت پیش`;
56:     if (diffDays < 7) return `${diffDays} روز پیش`;
57: 
58:     return formatDate(dateObj);
59:   } catch {
60:     return "—";
61:   }
