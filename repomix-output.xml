 1: import type { Announcement } from "#/types/announcement.ts";
 2: import type { ClassItem } from "#/types/class.ts";
 3: import type { User } from "#/types/user.ts";
 4: import { useMemo } from "react";
 5: 
 6: interface UseFilteredAnnouncementsProps {
 7:   announcements: Announcement[];
 8:   classes: ClassItem[];
 9:   currentUser: User | null;
10: }
11: 
12: export function useFilteredAnnouncements({
13:   announcements,
14:   classes,
15:   currentUser,
16: }: UseFilteredAnnouncementsProps) {
17:   const classMap = useMemo(() => {
18:     const map = new Map<string, ClassItem>();
19:     classes.forEach((c) => map.set(c.id, c));
20:     return map;
21:   }, [classes]);
22: 
23:   const filteredAnnouncements = useMemo(() => {
24:     if (!currentUser) return [];
25: 
26:     return announcements.filter((a) => {
27:       if (currentUser.role === "admin") return true;
28:       if (a.authorId === currentUser.id) return true;
29:       if (a.classId === "0") {
30:         const roles = a.targetRoles ?? ["admin", "teacher", "student"];
31:         return roles.includes(currentUser.role);
32:       }
33:       const targetClass = classMap.get(a.classId);
34:       if (!targetClass) return false;
35: 
36:       const audience = a.targetAudience ?? "students";
37:       const isTeacherOfThisClass = targetClass.teacherId === currentUser.id;
38:       const isStudentInThisClass = (targetClass.studentIds || []).includes(
39:         currentUser.id,
40:       );
41: 
42:       if (audience === "teacher") return isTeacherOfThisClass;
43:       if (audience === "students") return isStudentInThisClass;
44:       if (audience === "both")
45:         return isTeacherOfThisClass || isStudentInThisClass;
46: 
47:       return false;
48:     });
49:   }, [announcements, classMap, currentUser]);
50: 
51:   return filteredAnnouncements;
52: }

