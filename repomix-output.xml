 1743: <file path="src/contexts/AuthProvider.tsx">
 1744:  1: import { STORAGE_KEYS } from "#/configs/constants.ts";
 1745:  2: import { loginUser } from "#/services/auth.ts";
 1746:  3: import type { LoginPayload } from "#/types/auth.ts";
 1747:  4: import type { User } from "#/types/user.ts";
 1748:  5: import { useCallback, useMemo, useState, type ReactNode } from "react";
 1749:  6: import AuthContext from "./AuthContext";
 1750:  7: 
 1751:  8: interface AuthProviderProps {
 1752:  9:   children: ReactNode;
 1753: 10: }
 1754: 11: 
 1755: 12: function isValidUser(obj: unknown): obj is User {
 1756: 13:   if (typeof obj !== "object" || obj === null) return false;
 1757: 14:   const u = obj as Record<string, unknown>;
 1758: 15:   return (
 1759: 16:     typeof u.id === "string" &&
 1760: 17:     typeof u.name === "string" &&
 1761: 18:     typeof u.email === "string" &&
 1762: 19:     typeof u.role === "string" &&
 1763: 20:     typeof u.status === "string"
 1764: 21:   );
 1765: 22: }
 1766: 23: 
 1767: 24: function getStoredUser(): User | null {
 1768: 25:   try {
 1769: 26:     const storedUser = localStorage.getItem(STORAGE_KEYS.authUser);
 1770: 27:     if (!storedUser) return null;
 1771: 28: 
 1772: 29:     const parsed = JSON.parse(storedUser);
 1773: 30:     if (isValidUser(parsed)) {
 1774: 31:       return parsed;
 1775: 32:     }
 1776: 33:     localStorage.removeItem(STORAGE_KEYS.authUser);
 1777: 34:     return null;
 1778: 35:   } catch {
 1779: 36:     return null;
 1780: 37:   }
 1781: 38: }
 1782: 39: 
 1783: 40: function AuthProvider({ children }: AuthProviderProps) {
 1784: 41:   const [user, setUser] = useState<User | null>(() => getStoredUser());
 1785: 42:   const [isLoading] = useState(false);
 1786: 43: 
 1787: 44:   const login = useCallback(async (payload: LoginPayload) => {
 1788: 45:     const loggedInUser = await loginUser(payload);
 1789: 46: 
 1790: 47: 
 1791: 48:     const { password, ...safeUser } = loggedInUser;
 1792: 49: 
 1793: 50:     setUser(safeUser as User);
 1794: 51: 
 1795: 52:     try {
 1796: 53:       localStorage.setItem(STORAGE_KEYS.authUser, JSON.stringify(safeUser));
 1797: 54:     } catch (error) {
 1798: 55:       console.error("خطا در ذخیره‌سازی اطلاعات کاربر در LocalStorage:", error);
 1799: 56:     }
 1800: 57:   }, []);
 1801: 58: 
 1802: 59:   const logout = useCallback(() => {
