 7627:  23:   password?: string;
 7628:  24:   role: "admin" | "teacher" | "student";
 7629:  25:   status: "active" | "inactive";
 7630:  26: };
 7631:  27: 
 7632:  28: interface UserFormProps {
 7633:  29:   isOpen: boolean;
 7634:  30:   mode: "create" | "edit";
 7635:  31:   user?: User | null;
 7636:  32:   onClose: () => void;
 7637:  33:   onCreate: (values: CreateUserPayload) => Promise<void>;
 7638:  34:   onUpdate: (values: UpdateUserPayload) => Promise<void>;
 7639:  35: }
 7640:  36: 
 7641:  37: function UserForm({
 7642:  38:   isOpen,
 7643:  39:   mode,
 7644:  40:   user,
 7645:  41:   onClose,
 7646:  42:   onCreate,
 7647:  43:   onUpdate,
 7648:  44: }: UserFormProps) {
 7649:  45:   const defaultValues = useMemo<UserFormValues>(
 7650:  46:     () =>
 7651:  47:       mode === "create"
 7652:  48:         ? {
 7653:  49:             name: "",
 7654:  50:             email: "",
 7655:  51:             password: "",
 7656:  52:             role: "student",
 7657:  53:             status: "active",
 7658:  54:           }
 7659:  55:         : {
 7660:  56:             name: user?.name ?? "",
 7661:  57:             email: user?.email ?? "",
 7662:  58:             role: user?.role ?? "student",
 7663:  59:             status: user?.status ?? "active",
 7664:  60:           },
 7665:  61:     [mode, user],
 7666:  62:   );
 7667:  63: 
 7668:  64:   const {
 7669:  65:     register,
 7670:  66:     handleSubmit,
 7671:  67:     reset,
 7672:  68:     setError,
 7673:  69:     formState: { errors, isSubmitting },
 7674:  70:   } = useForm<UserFormValues>({
 7675:  71:     defaultValues,
 7676:  72:     mode: "onChange",
 7677:  73:   });
 7678:  74: 
 7679:  75:   useEffect(() => {
 7680:  76:     if (isOpen) {
 7681:  77:       reset(defaultValues);
 7682:  78:     }
 7683:  79:   }, [isOpen, defaultValues, reset]);
 7684:  80: 
 7685:  81:   const mapServerErrorToField = (
 7686:  82:     message: string,
 7687:  83:   ): { field: keyof UserFormValues | "root"; message: string } => {
 7688:  84:     if (message.includes("ایمیل")) return { field: "email", message };
 7689:  85:     if (message.includes("نام")) return { field: "name", message };
 7690:  86:     if (message.includes("رمز")) return { field: "password", message };
 7691:  87:     return { field: "root", message };
 7692:  88:   };
 7693:  89: 
 7694:  90:   const onSubmit = async (values: UserFormValues) => {
 7695:  91:     try {
 7696:  92:       if (mode === "create") {
 7697:  93:         await onCreate({
 7698:  94:           name: values.name.trim(),
 7699:  95:           email: values.email.trim(),
 7700:  96:           password: values.password?.trim() ?? "",
 7701:  97:           role: values.role,
 7702:  98:           status: values.status,
 7703:  99:         });
 7704: 100:       } else {
 7705: 101:         await onUpdate({
 7706: 102:           name: values.name.trim(),
 7707: 103:           email: values.email.trim(),
 7708: 104:           role: values.role,
 7709: 105:           status: values.status,
 7710: 106:         });
 7711: 107:       }
 7712: 108:       onClose();
