 8740:  4: export const baseApi = {
 8741:  5:   getAll: async <T>(
 8742:  6:     endpoint: string,
 8743:  7:     params?: Record<string, string | number | boolean>,
 8744:  8:   ): Promise<T[]> => {
 8745:  9:     const response = await axiosInstance.get<T[]>(endpoint, { params });
 8746: 10:     return response.data;
 8747: 11:   },
 8748: 12:   getById: async <T>(endpoint: string, id: ID): Promise<T> => {
 8749: 13:     const response = await axiosInstance.get<T>(`${endpoint}/${id}`);
 8750: 14:     return response.data;
 8751: 15:   },
 8752: 16:   create: async <T>(endpoint: string, data: Omit<T, "id">): Promise<T> => {
 8753: 17:     const response = await axiosInstance.post<T>(endpoint, data);
 8754: 18:     return response.data;
 8755: 19:   },
 8756: 20:   update: async <T>(endpoint: string, id: ID, data: Partial<T>): Promise<T> => {
 8757: 21:     const sanitizedData = Object.fromEntries(
 8758: 22:       Object.entries(data).filter(([, value]) => value !== undefined),
 8759: 23:     ) as Partial<T>;
 8760: 24:     const response = await axiosInstance.patch<T>(
 8761: 25:       `${endpoint}/${id}`,
 8762: 26:       sanitizedData,
 8763: 27:     );
 8764: 28:     return response.data;
 8765: 29:   },
 8766: 30:   delete: async (endpoint: string, id: ID): Promise<void> => {
 8767: 31:     await axiosInstance.delete(`${endpoint}/${id}`);
 8768: 32:   },
 8769: 33: };
