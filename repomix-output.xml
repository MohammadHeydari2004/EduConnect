 8852:  5: const endpoint = "/attendance";
 8853:  6: 
 8854:  7: export const attendanceService = {
 8855:  8:   getAll: () => baseApi.getAll<Attendance>(endpoint),
 8856:  9: 
 8857: 10:   getBySession: (sessionId: ID) =>
 8858: 11:     baseApi.getAll<Attendance>(endpoint, { sessionId }),
 8859: 12: 
 8860: 13:   getByStudent: (studentId: ID) =>
 8861: 14:     baseApi.getAll<Attendance>(endpoint, { studentId }),
 8862: 15: 
 8863: 16:   getByClass: (classId: ID) =>
 8864: 17:     baseApi.getAll<Attendance>(endpoint, { classId }),
 8865: 18: 
 8866: 19:   saveAttendanceForSession: async (
 8867: 20:     sessionId: ID,
 8868: 21:     classId: ID,
 8869: 22:     records: Array<{ studentId: ID; status: AttendanceStatus }>,
 8870: 23:   ): Promise<Attendance[]> => {
 8871: 24:     const existing = await attendanceService.getBySession(sessionId);
 8872: 25: 
 8873: 26:     const operations = records.map(async (record) => {
 8874: 27:       const existingRecord = existing.find(
 8875: 28:         (a) => a.studentId === record.studentId,
 8876: 29:       );
 8877: 30:       if (existingRecord) {
 8878: 31:         return baseApi.update<Attendance>(endpoint, existingRecord.id, {
 8879: 32:           status: record.status,
 8880: 33:         });
 8881: 34:       } else {
 8882: 35:         return baseApi.create<Attendance>(endpoint, {
 8883: 36:           sessionId,
 8884: 37:           classId,
 8885: 38:           studentId: record.studentId,
 8886: 39:           status: record.status,
 8887: 40:         } as Omit<Attendance, "id">);
 8888: 41:       }
 8889: 42:     });
 8890: 43: 
 8891: 44:     return Promise.all(operations);
 8892: 45:   },
 8893: 46: 
 8894: 47:   updateStatus: (id: ID, status: AttendanceStatus) =>
 8895: 48:     baseApi.update<Attendance>(endpoint, id, { status }),
 8896: 49: 
 8897: 50:   delete: (id: ID) => baseApi.delete(endpoint, id),
 8898: 51: 
 8899: 52:   calculateStudentStats: (attendances: Attendance[]) => {
 8900: 53:     const present = attendances.filter((a) => a.status === "present").length;
 8901: 54:     const late = attendances.filter((a) => a.status === "late").length;
 8902: 55:     const absent = attendances.filter((a) => a.status === "absent").length;
 8903: 56:     const total = attendances.length;
 8904: 57:     const attended = present + late;
 8905: 58:     const percentage = total > 0 ? (attended / total) * 100 : 0;
 8906: 59:     return { present, late, absent, total, attended, percentage };
 8907: 60:   },
 8908: 61: };
