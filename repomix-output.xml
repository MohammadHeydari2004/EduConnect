19:     errors.title = "عنوان نباید بیشتر از ۱۰۰ کاراکتر باشد.";
20:   }
21:   if (!content) {
22:     errors.content = "محتوای اطلاعیه الزامی است.";
23:   } else if (content.length < 10) {
24:     errors.content = "محتوا باید حداقل ۱۰ کاراکتر باشد.";
25:   }
26:   if (errors.title || errors.content) {
27:     errors.form = "لطفاً خطاهای فرم را برطرف کنید.";
28:   }
29: 
30:   return errors;
31: }

