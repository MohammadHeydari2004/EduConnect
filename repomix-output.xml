 2646: <file path="src/pages/announcements/validators.ts">
 2647:  1: export interface AnnouncementFormErrors {
 2648:  2:   title?: string;
 2649:  3:   content?: string;
 2650:  4:   form?: string;
 2651:  5: }
 2652:  6: 
 2653:  7: export function validateAnnouncementForm(values: {
 2654:  8:   title: string;
 2655:  9:   content: string;
 2656: 10: }): AnnouncementFormErrors {
 2657: 11:   const errors: AnnouncementFormErrors = {};
 2658: 12:   const title = values.title.trim();
 2659: 13:   const content = values.content.trim();
 2660: 14:   if (!title) {
 2661: 15:     errors.title = "عنوان اطلاعیه الزامی است.";
 2662: 16:   } else if (title.length < 3) {
 2663: 17:     errors.title = "عنوان باید حداقل ۳ کاراکتر باشد.";
 2664: 18:   } else if (title.length > 100) {
 2665: 19:     errors.title = "عنوان نباید بیشتر از ۱۰۰ کاراکتر باشد.";
 2666: 20:   }
 2667: 21:   if (!content) {
 2668: 22:     errors.content = "محتوای اطلاعیه الزامی است.";
 2669: 23:   } else if (content.length < 10) {
 2670: 24:     errors.content = "محتوا باید حداقل ۱۰ کاراکتر باشد.";
 2671: 25:   }
 2672: 26:   if (errors.title || errors.content) {
 2673: 27:     errors.form = "لطفاً خطاهای فرم را برطرف کنید.";
 2674: 28:   }
 2675: 29: 
 2676: 30:   return errors;
 2677: 31: }
 2678: </file>
