 9392:  1: export const formatDate = (date: string | Date | null | undefined): string => {
 9393:  2:   if (!date) return "—";
 9394:  3:   try {
 9395:  4:     const dateObj = typeof date === "string" ? new Date(date) : date;
 9396:  5:     if (isNaN(dateObj.getTime())) return "—";
 9397:  6:     return dateObj.toLocaleDateString("fa-IR");
 9398:  7:   } catch {
 9399:  8:     return "—";
 9400:  9:   }
 9401: 10: };
 9402: 11: 
 9403: 12: 
 9404: 13: 
 9405: 14: 
 9406: 15: 
 9407: 16: export const formatDateTime = (
 9408: 17:   date: string | Date | null | undefined,
 9409: 18: ): string => {
 9410: 19:   if (!date) return "—";
 9411: 20:   try {
 9412: 21:     const dateObj = typeof date === "string" ? new Date(date) : date;
 9413: 22:     if (isNaN(dateObj.getTime())) return "—";
 9414: 23: 
 9415: 24:     const datePart = dateObj.toLocaleDateString("fa-IR");
 9416: 25:     const timePart = dateObj.toLocaleTimeString("fa-IR", {
 9417: 26:       hour: "2-digit",
 9418: 27:       minute: "2-digit",
 9419: 28:     });
 9420: 29: 
 9421: 30:     return `${datePart} - ${timePart}`;
 9422: 31:   } catch {
 9423: 32:     return "—";
 9424: 33:   }
 9425: 34: };
 9426: 35: 
 9427: 36: 
 9428: 37: 
 9429: 38: 
 9430: 39: export const formatRelativeTime = (
 9431: 40:   date: string | Date | null | undefined,
 9432: 41: ): string => {
 9433: 42:   if (!date) return "—";
 9434: 43:   try {
 9435: 44:     const dateObj = typeof date === "string" ? new Date(date) : date;
 9436: 45:     if (isNaN(dateObj.getTime())) return "—";
 9437: 46: 
 9438: 47:     const now = new Date();
 9439: 48:     const diffMs = now.getTime() - dateObj.getTime();
 9440: 49:     const diffMinutes = Math.floor(diffMs / 60000);
 9441: 50:     const diffHours = Math.floor(diffMinutes / 60);
 9442: 51:     const diffDays = Math.floor(diffHours / 24);
 9443: 52: 
 9444: 53:     if (diffMinutes < 1) return "لحظاتی پیش";
 9445: 54:     if (diffMinutes < 60) return `${diffMinutes} دقیقه پیش`;
 9446: 55:     if (diffHours < 24) return `${diffHours} ساعت پیش`;
 9447: 56:     if (diffDays < 7) return `${diffDays} روز پیش`;
 9448: 57: 
 9449: 58:     return formatDate(dateObj);
 9450: 59:   } catch {
 9451: 60:     return "—";
 9452: 61:   }
 9453: 62: };
 9454: </file>
