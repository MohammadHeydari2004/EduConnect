  991: <file path="src/components/ui/Modal.tsx">
  992:  1: import { useEffect, useRef, type ReactNode } from "react";
  993:  2: import { createPortal } from "react-dom";
  994:  3: 
  995:  4: interface ModalProps {
  996:  5:   isOpen: boolean;
  997:  6:   title?: string;
  998:  7:   children: ReactNode;
  999:  8:   onClose: () => void;
 1000:  9: }
 1001: 10: 
 1002: 11: function Modal({ isOpen, title, children, onClose }: ModalProps) {
 1003: 12:   const modalRef = useRef<HTMLDivElement>(null);
 1004: 13:   const previousActiveElement = useRef<HTMLElement | null>(null);
 1005: 14: 
 1006: 15:   useEffect(() => {
 1007: 16:     if (!isOpen) return;
 1008: 17: 
 1009: 18:     previousActiveElement.current = document.activeElement as HTMLElement;
 1010: 19:     const originalOverflow = document.body.style.overflow;
 1011: 20:     document.body.style.overflow = "hidden";
 1012: 21: 
 1013: 22:     requestAnimationFrame(() => {
 1014: 23:       modalRef.current?.focus();
 1015: 24:     });
 1016: 25: 
 1017: 26:     const handleEscape = (e: KeyboardEvent) => {
 1018: 27:       if (e.key === "Escape") {
 1019: 28:         onClose();
 1020: 29:       }
 1021: 30:     };
 1022: 31: 
 1023: 32:     document.addEventListener("keydown", handleEscape);
 1024: 33: 
 1025: 34:     return () => {
 1026: 35:       document.body.style.overflow = originalOverflow;
 1027: 36:       document.removeEventListener("keydown", handleEscape);
 1028: 37:       previousActiveElement.current?.focus();
 1029: 38:     };
 1030: 39:   }, [isOpen, onClose]);
 1031: 40: 
 1032: 41:   if (!isOpen) return null;
 1033: 42: 
 1034: 43:   return createPortal(
 1035: 44:     <div
 1036: 45:       ref={modalRef}
 1037: 46:       role="dialog"
 1038: 47:       aria-modal="true"
 1039: 48:       aria-labelledby={title ? "modal-title" : undefined}
 1040: 49:       tabIndex={-1}
 1041: 50:       className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-3 outline-none sm:p-4"
 1042: 51:       onClick={(e) => {
 1043: 52:         if (e.target === e.currentTarget) {
 1044: 53:           onClose();
 1045: 54:         }
 1046: 55:       }}
 1047: 56:     >
 1048: 57:       <div className="w-full max-w-lg rounded-xl bg-white p-4 shadow-lg sm:p-6">
 1049: 58:         <div className="mb-4 flex items-center justify-between">
 1050: 59:           {title && (
 1051: 60:             <h2
 1052: 61:               id="modal-title"
 1053: 62:               className="text-base font-semibold text-gray-800 sm:text-lg"
 1054: 63:             >
 1055: 64:               {title}
 1056: 65:             </h2>
 1057: 66:           )}
 1058: 67:           <button
 1059: 68:             onClick={onClose}
 1060: 69:             className="flex h-8 w-8 items-center justify-center rounded-lg text-gray-500 transition hover:bg-gray-100 hover:text-gray-700"
 1061: 70:             aria-label="بستن"
 1062: 71:           >
 1063: 72:             <svg
 1064: 73:               className="h-5 w-5"
 1065: 74:               fill="none"
 1066: 75:               stroke="currentColor"
 1067: 76:               viewBox="0 0 24 24"
 1068: 77:               aria-hidden="true"
 1069: 78:             >
 1070: 79:               <path
 1071: 80:                 strokeLinecap="round"
 1072: 81:                 strokeLinejoin="round"
 1073: 82:                 strokeWidth={2}
 1074: 83:                 d="M6 18L18 6M6 6l12 12"
 1075: 84:               />
 1076: 85:             </svg>
 1077: 86:           </button>
 1078: 87:         </div>
 1079: 88:         <div>{children}</div>
 1080: 89:       </div>
 1081: 90:     </div>,
 1082: 91:     document.body,
 1083: 92:   );
 1084: 93: }
 1085: 94: 
 1086: 95: export default Modal;
 1087: </file>
