 6549: 111:               assignments,
 6550: 112:               submissions,
 6551: 113:               attendances,
 6552: 114:               announcements,
 6553: 115:             };
 6554: 116:             break;
 6555: 117:           }
 6556: 118:         }
 6557: 119:         if (!ignore) {
 6558: 120:           setData(result);
 6559: 121:           setError("");
 6560: 122:         }
 6561: 123:       } catch (err) {
