 8938: 27:   }
 8939: 28: 
 8940: 29:   if (user.password !== password) {
 8941: 30:     throw new Error("رمز عبور وارد شده صحیح نیست.");
 8942: 31:   }
 8943: 32: 
 8944: 33:   if (user.status !== "active") {
