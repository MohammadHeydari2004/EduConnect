 6122: 13: export function validateClassForm(form: ClassFormValues): ClassFormErrors {
 6123: 14:   const newErrors: ClassFormErrors = {};
 6124: 15: 
 6125: 16:   const title = form.title.trim();
 6126: 17:   if (!title) {
 6127: 18:     newErrors.title = "عنوان کلاس الزامی است.";
 6128: 19:   } else if (title.length < 3) {
 6129: 20:     newErrors.title = "عنوان باید حداقل ۳ کاراکتر باشد.";
 6130: 21:   } else if (title.length > 100) {
 6131: 22:     newErrors.title = "عنوان نباید بیشتر از ۱۰۰ کاراکتر باشد.";
 6132: 23:   }
 6133: 24: 
 6134: 25:   if (!form.teacherId) {
 6135: 26:     newErrors.teacherId = "انتخاب استاد الزامی است.";
 6136: 27:   }
 6137: 28: 
 6138: 29:   if (form.capacity < 1) {
 6139: 30:     newErrors.capacity = "ظرفیت باید حداقل ۱ نفر باشد.";
 6140: 31:   } else if (form.capacity > 1000) {
 6141: 32:     newErrors.capacity = "ظرفیت نمی‌تواند بیشتر از ۱۰۰۰ نفر باشد.";
 6142: 33:   }
 6143: 34: 
 6144: 35:   if (form.studentIds.length > form.capacity) {
 6145: 36:     newErrors.students = `تعداد دانشجویان (${form.studentIds.length}) بیشتر از ظرفیت (${form.capacity}) است.`;
 6146: 37:   }
 6147: 38: 
 6148: 39:   if (form.description && form.description.length > 500) {
 6149: 40:     newErrors.description = "توضیحات نباید بیشتر از ۵۰۰ کاراکتر باشد.";
 6150: 41:   }
 6151: 42: 
 6152: 43:   return newErrors;
 6153: 44: }
