 7714: 110:       if (err instanceof Error) {
 7715: 111:         const { field, message } = mapServerErrorToField(err.message);
 7716: 112:         if (field === "root") {
 7717: 113:           setError("root", { type: "server", message });
 7718: 114:         } else {
 7719: 115:           setError(field, { type: "server", message });
 7720: 116:         }
 7721: 117:       } else {
 7722: 118:         setError("root", {
 7723: 119:           type: "server",
 7724: 120:           message: "خطای غیرمنتظره‌ای رخ داد.",
 7725: 121:         });
 7726: 122:       }
 7727: 123:     }
 7728: 124:   };
 7729: 125: 
 7730: 126:   const title = mode === "create" ? "ایجاد کاربر جدید" : "ویرایش اطلاعات کاربر";
 7731: 127: 
 7732: 128:   return (
 7733: 129:     <Modal isOpen={isOpen} title={title} onClose={onClose}>
 7734: 130:       <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
 7735: 131:         {errors.root && (
 7736: 132:           <div
 7737: 133:             className="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
 7738: 134:             role="alert"
 7739: 135:           >
 7740: 136:             {errors.root.message}
 7741: 137:           </div>
 7742: 138:         )}
 7743: 139: 
 7744: 140:         <Input
 7745: 141:           label="نام"
 7746: 142:           autoFocus
 7747: 143:           autoComplete="name"
