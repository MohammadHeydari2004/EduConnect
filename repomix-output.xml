 9091:  11: async function getAllUsers(): Promise<User[]> {
 9092:  12:   return baseApi.getAll<User>(endpoint);
 9093:  13: }
 9094:  14: 
 9095:  15: async function getUserById(id: ID): Promise<User> {
 9096:  16:   return baseApi.getById<User>(endpoint, id);
 9097:  17: }
 9098:  18: 
 9099:  19: async function ensureEmailIsUnique(
 9100:  20:   email: string,
 9101:  21:   excludeUserId?: ID,
 9102:  22: ): Promise<void> {
 9103:  23:   const normalizedEmail = email.trim().toLowerCase();
 9104:  24:   const duplicates = await baseApi.getAll<User>(endpoint, {
 9105:  25:     email: normalizedEmail,
 9106:  26:   });
 9107:  27: 
 9108:  28:   const duplicate = duplicates.find((user) => user.id !== excludeUserId);
 9109:  29:   if (duplicate) {
 9110:  30:     throw new Error("این ایمیل قبلاً ثبت شده است.");
 9111:  31:   }
 9112:  32: }
 9113:  33: 
 9114:  34: async function getAdminUsers(): Promise<User[]> {
 9115:  35:   return baseApi.getAll<User>(endpoint, { role: "admin" });
 9116:  36: }
 9117:  37: 
 9118:  38: async function ensureNotLastAdmin(userId: ID): Promise<void> {
 9119:  39:   const targetUser = await getUserById(userId);
 9120:  40:   if (!targetUser) throw new Error("کاربر موردنظر پیدا نشد.");
 9121:  41:   if (targetUser.role !== "admin") return;
 9122:  42: 
 9123:  43:   const adminUsers = await getAdminUsers();
 9124:  44:   if (adminUsers.length <= 1) {
 9125:  45:     throw new Error("امکان حذف یا تغییر آخرین مدیر سیستم وجود ندارد.");
 9126:  46:   }
 9127:  47: }
 9128:  48: 
 9129:  49: async function ensureNotLastAdminIfDeactivating(user: User): Promise<void> {
 9130:  50:   if (user.role !== "admin" || user.status === "inactive") return;
 9131:  51:   const activeAdmins = (await getAdminUsers()).filter(
 9132:  52:     (admin) => admin.status === "active",
 9133:  53:   );
 9134:  54:   if (activeAdmins.length <= 1) {
 9135:  55:     throw new Error("امکان غیرفعال‌سازی آخرین مدیر سیستم وجود ندارد.");
 9136:  56:   }
 9137:  57: }
 9138:  58: 
 9139:  59: export const userService = {
 9140:  60:   getAll: getAllUsers,
 9141:  61:   getById: getUserById,
 9142:  62: 
 9143:  63:   async create(data: CreateUserPayload): Promise<User> {
 9144:  64:     await ensureEmailIsUnique(data.email);
 9145:  65:     const payload: Omit<User, "id"> = {
 9146:  66:       name: data.name.trim(),
 9147:  67:       email: data.email.trim().toLowerCase(),
 9148:  68:       password: data.password,
 9149:  69:       role: data.role,
 9150:  70:       status: data.status,
 9151:  71:     };
 9152:  72:     return baseApi.create<User>(endpoint, payload);
 9153:  73:   },
 9154:  74: 
 9155:  75:   async update(id: ID, data: UpdateUserPayload): Promise<User> {
 9156:  76:     await ensureEmailIsUnique(data.email, id);
 9157:  77:     const existingUser = await getUserById(id);
 9158:  78: 
 9159:  79:     if (existingUser.role === "admin" && data.role !== "admin") {
 9160:  80:       await ensureNotLastAdmin(id);
 9161:  81:     }
 9162:  82:     if (
 9163:  83:       existingUser.role === "admin" &&
 9164:  84:       existingUser.status === "active" &&
 9165:  85:       data.status === "inactive"
 9166:  86:     ) {
 9167:  87:       await ensureNotLastAdminIfDeactivating(existingUser);
 9168:  88:     }
 9169:  89: 
 9170:  90:     const { password: _, ...userWithoutPassword } = existingUser;
 9171:  91: 
 9172:  92:     return baseApi.update<User>(endpoint, id, {
 9173:  93:       ...userWithoutPassword,
 9174:  94:       name: data.name.trim(),
 9175:  95:       email: data.email.trim().toLowerCase(),
 9176:  96:       role: data.role,
 9177:  97:       status: data.status,
 9178:  98:     });
 9179:  99:   },
 9180: 100: 
 9181: 101:   async delete(id: ID): Promise<void> {
 9182: 102:     await ensureNotLastAdmin(id);
 9183: 103:     await baseApi.delete(endpoint, id);
 9184: 104:   },
 9185: 105: 
 9186: 106:   async toggleStatus(id: ID): Promise<User> {
 9187: 107:     const user = await getUserById(id);
 9188: 108:     await ensureNotLastAdminIfDeactivating(user);
 9189: 109:     const nextStatus: RecordStatus =
 9190: 110:       user.status === "active" ? "inactive" : "active";
 9191: 111:     return baseApi.update<User>(endpoint, id, { ...user, status: nextStatus });
 9192: 112:   },
 9193: 113: 
 9194: 114:   async changeRole(id: ID, role: UserRole): Promise<User> {
 9195: 115:     const user = await getUserById(id);
 9196: 116:     if (user.role === "admin" && role !== "admin") {
 9197: 117:       await ensureNotLastAdmin(id);
 9198: 118:     }
 9199: 119:     return baseApi.update<User>(endpoint, id, { ...user, role });
 9200: 120:   },
 9201: 121: 
 9202: 122:   getAdminUsers,
 9203: 123: };
 9204: </file>
