 2591: <file path="src/pages/announcements/useFilteredAnnouncements.ts">
 2592:  1: import type { Announcement } from "#/types/announcement.ts";
 2593:  2: import type { ClassItem } from "#/types/class.ts";
 2594:  3: import type { User } from "#/types/user.ts";
 2595:  4: import { useMemo } from "react";
 2596:  5: 
 2597:  6: interface UseFilteredAnnouncementsProps {
 2598:  7:   announcements: Announcement[];
 2599:  8:   classes: ClassItem[];
 2600:  9:   currentUser: User | null;
 2601: 10: }
 2602: 11: 
 2603: 12: export function useFilteredAnnouncements({
 2604: 13:   announcements,
 2605: 14:   classes,
 2606: 15:   currentUser,
 2607: 16: }: UseFilteredAnnouncementsProps) {
 2608: 17:   const classMap = useMemo(() => {
 2609: 18:     const map = new Map<string, ClassItem>();
 2610: 19:     classes.forEach((c) => map.set(c.id, c));
 2611: 20:     return map;
 2612: 21:   }, [classes]);
 2613: 22: 
 2614: 23:   const filteredAnnouncements = useMemo(() => {
 2615: 24:     if (!currentUser) return [];
 2616: 25: 
 2617: 26:     return announcements.filter((a) => {
 2618: 27:       if (currentUser.role === "admin") return true;
 2619: 28:       if (a.authorId === currentUser.id) return true;
 2620: 29:       if (a.classId === "0") {
 2621: 30:         const roles = a.targetRoles ?? ["admin", "teacher", "student"];
 2622: 31:         return roles.includes(currentUser.role);
 2623: 32:       }
 2624: 33:       const targetClass = classMap.get(a.classId);
 2625: 34:       if (!targetClass) return false;
 2626: 35: 
 2627: 36:       const audience = a.targetAudience ?? "students";
 2628: 37:       const isTeacherOfThisClass = targetClass.teacherId === currentUser.id;
 2629: 38:       const isStudentInThisClass = (targetClass.studentIds || []).includes(
 2630: 39:         currentUser.id,
 2631: 40:       );
 2632: 41: 
 2633: 42:       if (audience === "teacher") return isTeacherOfThisClass;
 2634: 43:       if (audience === "students") return isStudentInThisClass;
 2635: 44:       if (audience === "both")
 2636: 45:         return isTeacherOfThisClass || isStudentInThisClass;
 2637: 46: 
 2638: 47:       return false;
 2639: 48:     });
 2640: 49:   }, [announcements, classMap, currentUser]);
 2641: 50: 
 2642: 51:   return filteredAnnouncements;
 2643: 52: }
 2644: </file>
