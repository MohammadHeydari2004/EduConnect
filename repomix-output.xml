 1849: <file path="src/contexts/ToastProvider.tsx">
 1850:  1: import {
 1851:  2:   type ReactNode,
 1852:  3:   useCallback,
 1853:  4:   useEffect,
 1854:  5:   useRef,
 1855:  6:   useState,
 1856:  7: } from "react";
 1857:  8: import { type Toast, ToastContext, type ToastType } from "./ToastContext";
 1858:  9: 
 1859: 10: export function ToastProvider({ children }: { children: ReactNode }) {
 1860: 11:   const [toasts, setToasts] = useState<Toast[]>([]);
 1861: 12:   const timersRef = useRef<Map<string, ReturnType<typeof setTimeout>>>(
 1862: 13:     new Map(),
 1863: 14:   );
 1864: 15: 
 1865: 16:   const removeToast = useCallback((id: string) => {
 1866: 17:     setToasts((prev) => prev.filter((t) => t.id !== id));
 1867: 18:     const timer = timersRef.current.get(id);
 1868: 19:     if (timer) {
 1869: 20:       clearTimeout(timer);
 1870: 21:       timersRef.current.delete(id);
 1871: 22:     }
 1872: 23:   }, []);
 1873: 24: 
 1874: 25:   const addToast = useCallback(
 1875: 26:     (message: string, type: ToastType = "info") => {
 1876: 27:       const id = crypto.randomUUID();
 1877: 28:       setToasts((prev) => [...prev, { id, message, type }]);
 1878: 29: 
 1879: 30:       const timer = setTimeout(() => {
 1880: 31:         removeToast(id);
 1881: 32:       }, 4000);
 1882: 33: 
 1883: 34:       timersRef.current.set(id, timer);
 1884: 35:     },
 1885: 36:     [removeToast],
 1886: 37:   );
 1887: 38: 
 1888: 39:   useEffect(() => {
 1889: 40:     const timers = timersRef.current;
 1890: 41:     return () => {
 1891: 42:       timers.forEach((timer) => clearTimeout(timer));
 1892: 43:     };
 1893: 44:   }, []);
 1894: 45: 
 1895: 46:   return (
 1896: 47:     <ToastContext.Provider value={{ addToast }}>
 1897: 48:       {children}
 1898: 49:       <div
 1899: 50:         role="log"
 1900: 51:         aria-live="polite"
 1901: 52:         aria-label="اعلان‌های سیستم"
 1902: 53:         className="pointer-events-none fixed top-4 right-4 z-100 flex w-80 flex-col gap-3"
 1903: 54:       >
 1904: 55:         {toasts.map((toast) => (
 1905: 56:           <div
 1906: 57:             key={toast.id}
 1907: 58:             role={toast.type === "error" ? "alert" : "status"}
 1908: 59:             className={`pointer-events-auto flex items-center gap-3 rounded-lg border p-4 shadow-lg transition-all duration-300 ${toast.type === "success" ? "border-green-200 bg-green-50 text-green-800" : toast.type === "error" ? "border-red-200 bg-red-50 text-red-800" : toast.type === "warning" ? "border-yellow-200 bg-yellow-50 text-yellow-800" : "border-blue-200 bg-blue-50 text-blue-800"}`}
 1909: 60:           >
 1910: 61:             <p className="flex-1 text-sm leading-relaxed font-medium">
 1911: 62:               {toast.message}
 1912: 63:             </p>
 1913: 64:             <button
 1914: 65:               onClick={() => removeToast(toast.id)}
 1915: 66:               className="shrink-0 text-gray-500 transition hover:text-gray-700"
 1916: 67:               aria-label="بستن اعلان"
 1917: 68:             >
 1918: 69:               ✕
 1919: 70:             </button>
 1920: 71:           </div>
 1921: 72:         ))}
 1922: 73:       </div>
 1923: 74:     </ToastContext.Provider>
 1924: 75:   );
 1925: 76: }
 1926: </file>
