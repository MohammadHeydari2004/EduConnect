# آدرس پایه API برای محیط توسعه
# ex) http://localhost:4103
# باید با پورت دستور server در فایل دستورات پروژه یکی باشد. (فایل package.json)
VITE_API_BASE_URL=

# مشخص کردن محیط اجرا
# ex) (development, production, test)
VITE_APP_ENV=

# پیشوند ذخیره‌سازی در LocalStorage (برای جلوگیری از تداخل در یک دامنه)
# ex) edu_dev_
VITE_STORAGE_PREFIX=

# فعال‌سازی لاگ‌های دیباگ در کنسول (true/false)
VITE_DEBUG=false

# فعال‌سازی React DevTools در production (true/false)
VITE_REACT_DEVTOOLS=false

# حداکثر اندازه فایل آپلود (بایت)
VITE_MAX_UPLOAD_SIZE=10485760

# Тайم‌اوت درخواست‌های API (میلی‌ثانیه)
VITE_API_TIMEOUT=30000

# فعال‌سازیStrict Mode در React
VITE_REACT_STRICT_MODE=true

# پیشوند کلیدهای ذخیره‌سازی در LocalStorage
VITE_STORAGE_KEY_PREFIX=educonnect_

# --- دستورات بررسی و ساخت ---

# ۱. بررسی کامل TypeScript (بدون skipLibCheck)
# npx tsc --noEmit --skipLibCheck false

# ۲. بررسی کامل ESLint/Oxlint (بدونwarning)
# npm run lint:check

# ۳. اجرای تست‌ها با پوشش کد
# npm run test:ci

# ۴. بررسی کامل پیش از کامیت (typecheck + lint + test)
# npm run check

# ۵. اجرای Development Server
# npm run dev

# ۶. تست Build نهایی
# npm run build